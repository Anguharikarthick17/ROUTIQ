# ROUTIQ Environment Configuration Template
# Copy this file to .env.local for local development.

# Supabase Configuration (Optional for in-memory / local SQLite fallback, required for cloud Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Google Gemini AI Integration (Required for ROUTIQ AI Copilot live API answers)
VITE_GEMINI_API_KEY=your-gemini-api-key-placeholder

# OSRM / OpenStreetMap Routing Configuration (Uses public OSRM by default)
VITE_OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving

# Application Settings
VITE_APP_ENV=development
VITE_DEMO_MODE=true
